---
import { AstroSeo } from "@astrolib/seo";
---

<AstroSeo
  title="Fataplus - Product Design Agency"
  description="Fataplus is a product design agency based in Antananarivo, Madagascar, dedicated to digital transformation."
  canonical="https://fata.plus"
  openGraph={{
    url: "https://fata.plus",
    title: "Fataplus - Product Design Agency",
    description: "Fataplus is a product design agency based in Antananarivo, Madagascar, dedicated to digital transformation.",
    images: [
      {
        url: "https://fata.plus/og-image.jpg",
        width: 1200,
        height: 630,
        alt: "Fataplus Open Graph Image",
        type: "image/jpeg",
      },
    ],
    site_name: "Fataplus",
    type: "website",
    locale: "en_US",
  }}
  twitter={{
    handle: "@fataplus",
    site: "@fataplus",
    cardType: "summary_large_image",
  }}
/>

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://www.yourwebsite.com/" />
<meta property="og:title" content="Your Website Title" />
<meta
  property="og:description"
  content="A brief description of your website content."
/>
<meta
  property="og:image"
  content="https://www.yourwebsite.com/path/to/image.jpg"
/>

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="https://www.yourwebsite.com/" />
<meta property="twitter:title" content="Your Website Title" />
<meta
  property="twitter:description"
  content="A brief description of your website content."
/>
<meta
  property="twitter:image"
  content="https://www.yourwebsite.com/path/to/image.jpg"
/>

<!-- Canonical URL -->
<link rel="canonical" href="https://www.yourwebsite.com/" />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />
