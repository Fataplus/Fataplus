// import LanguageSwitcher from "@/components/i18n/LanguageSwitcher.astro";
// import { getLocale } from 'astro-i18next';
// import { getLanguageInfo } from '@/i18n/utils';

const currentLocale = "en";
const languageInfo = { dir: "ltr" };
---

